# Wird von setup.sh nach /etc/caddy/Caddyfile geschrieben (Platzhalter in __GROSS__ werden ersetzt).
# Caddy holt das HTTPS-Zertifikat automatisch (Let's Encrypt). Der Platzhalter für die Anmeldung wird
# zum basic_auth-Block (Benutzername/Passwort), wenn setup.sh einen Benutzernamen bekommt, sonst entfällt er.
__DOMAIN__ {
	encode zstd gzip

__AUTH__
	reverse_proxy 127.0.0.1:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
